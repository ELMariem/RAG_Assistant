# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc

# ChromaDB persistent storage (regenerated by ingestion)
chroma_db/

# Source documents and generated figures (may be large, personal, or copyrighted course material)
data/documents/*
!data/documents/.gitkeep
data/figures/*
!data/figures/.gitkeep


# Environment/secrets (if you ever add API keys, HF tokens, etc.)
.env

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/